# Deployment base path. Use "/" for a custom domain, or "/<repo>/" for a
# GitHub Pages project site such as https://user.github.io/via-augusta/.
VITE_BASE_PATH=/

# Public site URL including the base path, used for canonical and social URLs.
VITE_SITE_URL=https://example.github.io/via-augusta/

# Optional public repository link shown in the About dialog.
VITE_REPOSITORY_URL=https://github.com/example/via-augusta

# Optional self-hosted providers (defaults shown).
# VITE_BROUTER_URL=https://brouter.de/brouter
# VITE_BROUTER_PROFILE=hiking-mountain
# VITE_PHOTON_URL=https://photon.komoot.io/api/
# VITE_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
